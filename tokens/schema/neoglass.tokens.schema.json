{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/neoglass/tokens.schema.json",
  "title": "NeoGlass X token source baseline",
  "description": "A deliberately small project-level guard for DTCG-style token source files. It is not a replacement for the DTCG specification.",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/node"
  },
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "$type": { "type": "string" },
        "$description": { "type": "string" },
        "$value": {}
      },
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/node" },
          { "type": ["string", "number", "boolean", "array", "null", "object"] }
        ]
      }
    }
  }
}
