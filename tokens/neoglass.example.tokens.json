{
  "color": {
    "brand": {
      "$type": "color",
      "$description": "Illustrative brand palette. Experimental.",
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0,
            0.851,
            0.408
          ],
          "hex": "#00D968"
        }
      },
      "focus": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.42,
            1.0,
            0.647
          ],
          "hex": "#6BFFA5"
        }
      }
    },
    "surface": {
      "$type": "color",
      "canvas-dark": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0196,
            0.0275,
            0.0235
          ],
          "hex": "#050706"
        }
      },
      "default-dark": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0509,
            0.0667,
            0.0588
          ],
          "hex": "#0D110F"
        }
      }
    }
  },
  "dimension": {
    "spacing": {
      "$type": "dimension",
      "$description": "Example spacing scale.",
      "xs": {
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "standard": {
        "$value": {
          "value": 180,
          "unit": "ms"
        }
      },
      "panel": {
        "$value": {
          "value": 240,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0.0,
          0.0,
          1.0
        ]
      }
    }
  }
}
