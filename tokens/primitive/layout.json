{
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 24, "unit": "px" } },
    "6": { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } }
  },
  "control": { "$type": "dimension", "height": { "$value": { "value": 36, "unit": "px" } } },
  "font": {
    "$type": "string",
    "sans": { "$value": "Inter, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif" },
    "mono": { "$value": "\"Cascadia Code\", \"SFMono-Regular\", Consolas, monospace" }
  }
}
