{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "standard": { "$value": { "value": 180, "unit": "ms" } }
    },
    "ease": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0, 0, 1] } }
  },
  "material": { "$type": "dimension", "backdrop-blur": { "$value": { "value": 16, "unit": "px" } } }
}
